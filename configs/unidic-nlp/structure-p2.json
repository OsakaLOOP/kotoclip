{
  "schema": "kotoclip.unidic-structure-training.v1",
  "model_id": "unidic-structure-p2",
  "architecture": {
    "encoder": "token_feature_transformer",
    "layers": 6,
    "hidden_size": 256,
    "attention_heads": 8,
    "feedforward_size": 1024,
    "dropout": 0.15,
    "max_tokens": 256,
    "vocab_size": 32768,
    "feature_embeddings": ["lemma_id", "surface_id", "pos_id", "conj_id", "register_id"]
  },
  "heads": ["sentence", "compound", "bunsetsu", "dependency", "dependency_label"],
  "loss_weights": {"sentence": 1.0, "compound": 1.0, "bunsetsu": 1.0, "dependency": 0.8},
  "training": {
    "optimizer": "adamw",
    "learning_rate": 0.0001,
    "warmup_steps": 1000,
    "effective_batch_tokens": 512,
    "weight_decay": 0.01,
    "gradient_clip": 0.5,
    "early_stopping_patience": 3,
    "seeds": [13, 37, 71]
  },
  "weak_label_loss_weight": 0.35,
  "coordinate_system": "unicode_scalar_half_open"
}
