{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kotoclip",
  "version": "0.1.2",
  "identifier": "com.kotoclip.app",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kotoclip",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/Kotoclip Library/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../data/dict-sources/starter.kdict": "dict-sources/starter.kdict",
      "../data/dict-sources/daijirin.kdict": "dict-sources/daijirin.kdict",
      "../data/dict-sources/shogakukan.kdict": "dict-sources/shogakukan.kdict",
      "../data/dict-sources/crown.kdict": "dict-sources/crown.kdict",
      "../release-resources/nlp/cwj.dic": "nlp/cwj.dic",
      "../release-resources/nlp/csj.dic": "nlp/csj.dic",
      "../release-resources/python": "python",
      "../scripts/nlp_provider.py": "scripts/nlp_provider.py",
      "../scripts/nlp_adapters.py": "scripts/nlp_adapters.py",
      "../scripts/nlp_resources.py": "scripts/nlp_resources.py",
      "../src/version/changelog.json": "changelog.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
