{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kotoclip",
  "version": "0.1.2",
  "identifier": "com.kotoclip.app",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kotoclip",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/Kotoclip Library/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "resources": []
  }
}
